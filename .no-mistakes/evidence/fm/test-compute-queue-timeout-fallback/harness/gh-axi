#!/usr/bin/env python3
"""Disposable gh-axi stand-in that speaks the subset of the GitHub CLI surface
bin/fm-test-compute.sh uses, over real HTTP to the localhost emulator."""
import json, os, pathlib, subprocess, sys, urllib.error, urllib.request, zipfile

BASE = os.environ["EMU_BASE"]
args = sys.argv[1:]


def fail(msg, code):
    print(msg, file=sys.stderr)
    sys.exit(code)


def request(method, path, data=None):
    req = urllib.request.Request(BASE + path, data=data, method=method)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.read()
    except urllib.error.HTTPError as e:
        fail(f"error: HTTP {e.code} {e.reason}", 1)
    except Exception as e:  # noqa: BLE001 - transport failure, any kind
        fail(f"curl: (52) Empty reply from server ({e.__class__.__name__})", 52)


if args[:2] == ["run", "download"]:
    run_id = args[2]
    out = pathlib.Path(args[args.index("--dir") + 1])
    blob = request("GET", f"/repos/example/firstmate/actions/runs/{run_id}/artifacts")
    out.mkdir(parents=True, exist_ok=True)
    archive = out.parent / f"artifacts-{run_id}.zip"
    archive.write_bytes(blob)
    with zipfile.ZipFile(archive) as z:
        z.extractall(out)
    sys.exit(0)

if not args or args[0] != "api":
    fail(f"gh-axi stand-in: unsupported invocation {args}", 2)
rest = args[1:]
method = "GET"
if rest and rest[0] in ("POST", "GET", "PATCH", "DELETE", "PUT"):
    method = rest.pop(0)
path = rest.pop(0)
data = None
jq = None
while rest:
    flag = rest.pop(0)
    if flag == "--input":
        data = pathlib.Path(rest.pop(0)).read_bytes()
    elif flag == "--jq":
        jq = rest.pop(0)
    elif flag == "--full":
        continue
    else:
        fail(f"gh-axi stand-in: unsupported flag {flag}", 2)
body = request(method, path, data)
if jq:
    res = subprocess.run(["jq", "-r", jq], input=body, capture_output=True)
    if res.returncode != 0:
        sys.stderr.write(res.stderr.decode())
        sys.exit(res.returncode)
    sys.stdout.buffer.write(res.stdout)
else:
    sys.stdout.buffer.write(body)
