#!/usr/bin/env python3
"""Disposable glab stand-in for the GitLab subset bin/fm-test-compute.sh uses."""
import os, pathlib, sys, urllib.error, urllib.request

BASE = os.environ["EMU_BASE"]
args = sys.argv[1:]

if args[:2] == ["auth", "status"]:
    sys.exit(0 if os.environ.get("EMU_GITLAB_AUTH", "1") == "1" else 1)

if not args or args[0] != "api":
    print(f"glab stand-in: unsupported invocation {args}", file=sys.stderr)
    sys.exit(2)
rest = args[1:]
method = "GET"
data = None
path = None
while rest:
    item = rest.pop(0)
    if item == "--hostname":
        rest.pop(0)
    elif item == "--method":
        method = rest.pop(0)
    elif item == "--input":
        data = pathlib.Path(rest.pop(0)).read_bytes()
    elif path is None:
        path = item
    else:
        rest.insert(0, item)
        rest.pop(0)
req = urllib.request.Request(BASE + "/api/v4/" + path, data=data, method=method)
if data is not None:
    req.add_header("Content-Type", "application/json")
try:
    with urllib.request.urlopen(req, timeout=30) as r:
        sys.stdout.buffer.write(r.read())
except urllib.error.HTTPError as e:
    print(f"glab: HTTP {e.code} {e.reason}", file=sys.stderr)
    sys.exit(1)
except Exception as e:  # noqa: BLE001
    print(f"glab: transport failure ({e.__class__.__name__})", file=sys.stderr)
    sys.exit(1)
